<full-backup-content>
    <!-- Исключаем зашифрованные SharedPreferences из резервного копирования -->
    <exclude domain="sharedpref" path="secure_prefs.xml"/>
    <exclude domain="sharedpref" path="androidx.security.crypto.master_key_keyset.xml"/>
</full-backup-content>